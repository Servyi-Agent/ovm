# test262 gate for KetteVM.
#
# The runners have many known failures, so CI does not require a clean run.
# Both engines use the same gate: at least `min_pass` tests passing, and no
# more than `max_panic` caught panics. Update these intentionally when
# coverage or the corpus changes.
#
# Calibrated against test262 main:
#   d53ebc8b1931d9f1541e43d59650776e4b766248
# with KETTEVM_JOBS=64:
#   match:  total=53910 pass=12582 fail=26315 panic=0
#   become: total=53910 pass=12582 fail=26315 panic=0
#
# Both interpreters now dispatch through the same handlers, so the shared
# minimum is their common current pass count.
corpus_commit=d53ebc8b1931d9f1541e43d59650776e4b766248
min_pass=12582
max_panic=0
